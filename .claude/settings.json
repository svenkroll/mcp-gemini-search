{
  "permissions": {
    "additionalDirectories": [
      "/tmp/claude-tickets",
      "/private/tmp/claude-tickets"
    ],
    "allow": [
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(mkdir -p /tmp/claude-tickets:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git push -u origin ticket/:*)",
      "Bash(git push origin ticket/:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Read(/tmp/claude-tickets/**)",
      "Write(/tmp/claude-tickets/**)",
      "Edit(/tmp/claude-tickets/**)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh release view:*)",
      "Bash(git ls-remote:*)",
      "Bash(git push origin renovate/:*)",
      "Bash(jq:*)",
      "Bash(.claude/scripts/renovate-identity.sh:*)",
      "Bash(.claude/scripts/check-dependency-fix.sh:*)",
      "Bash(DRY_RUN=1 .claude/scripts/merge-dependency-pr.sh:*)",
      "Bash(.claude/scripts/merge-dependency-pr.sh:*)"
    ],
    "deny": [
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue create:*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
