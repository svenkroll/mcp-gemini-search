# Gemini Search MCP configuration example, see docs/adr/0010-configuration.md.
# Copy to .env and fill in values locally. Every assignment below is an
# intentionally empty placeholder; never commit real secrets.

# Required. API key from Google AI Studio (Gemini Developer API).
GEMINI_API_KEY=

# Optional. Product model, default gemini-3.8-flash.
GEMINI_MODEL=

# Optional. Total Gemini call timeout in seconds (1-300), default 60.
GEMINI_TIMEOUT_SECONDS=

# Optional. Maximum parallel Gemini calls (1-32), default 4.
GEMINI_MAX_CONCURRENCY=

# Optional. Retries after the first attempt for 429/5xx (0-5), default 2.
GEMINI_MAX_RETRIES=

# Optional. Register the analyze_url tool (true/false), default false.
# See docs/adr/0004-analyze-url-tool-contract.md before enabling it.
ANALYZE_URL_ENABLED=

# Optional. Log query content (true/false), default false.
LOG_QUERIES=

# Optional. debug, info, warning or error, default info.
LOG_LEVEL=

# Optional. stdio or http, default stdio.
MCP_TRANSPORT=

# Optional. Bind address for http, default 127.0.0.1.
MCP_HOST=

# Optional. Port for http, default 8000.
MCP_PORT=

# Required for http. Static bearer token, at least 32 characters.
MCP_BEARER_TOKEN=
