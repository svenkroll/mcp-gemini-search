# Gemini Search MCP configuration example.
# Copy to .env and fill in values locally. Every assignment below is an
# intentionally empty placeholder; never commit real secrets.

# API key from Google AI Studio (Gemini Developer API).
GEMINI_API_KEY=

# Product model identifier, see docs/offene-fragen.md.
GEMINI_MODEL=

# Static bearer token protecting the HTTP transport.
MCP_BEARER_TOKEN=

# Optional: enable query logging (disabled by default).
LOG_QUERIES=
